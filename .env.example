# Database Connection (Neon, Supabase, or PostgreSQL connection string for Vercel)
# e.g. postgresql://user:password@ep-cool-project-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL="postgresql://username:password@hostname:5432/databasename?sslmode=require"

# JWT Secret for Session Authentication (Generate a secure random string for production)
JWT_SECRET="replace_with_a_secure_random_jwt_secret_key"

# Live Application Base URL
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Default Contact / WhatsApp Numbers
NEXT_PUBLIC_DEFAULT_WHATSAPP="254100382352"
NEXT_PUBLIC_DEFAULT_PHONE="+254100382352"
NEXT_PUBLIC_DEFAULT_EMAIL="info@rentals.ke"
