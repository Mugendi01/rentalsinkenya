# Supabase Database Connections:
# 1. DATABASE_URL (Transaction Pooler - port 6543) used by Vercel serverless queries
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# 2. DIRECT_URL (Direct Connection - port 5432) used by Prisma CLI for migrations / db push
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# JWT Secret for Session Authentication (Generate a secure random string for production)
JWT_SECRET="replace_with_a_secure_random_jwt_secret_key"

# Live Application Base URL (Production)
NEXT_PUBLIC_APP_URL="https://rentalsinkenya.co.ke"

# Default Contact / WhatsApp Numbers
NEXT_PUBLIC_DEFAULT_WHATSAPP="254100382352"
NEXT_PUBLIC_DEFAULT_PHONE="+254100382352"
NEXT_PUBLIC_DEFAULT_EMAIL="info@rentalsinkenya.co.ke"
